// The ISO base media file format, ISO/IEC 14496-12: the box tree that every
// MP4, fragmented MP4 and CMAF segment is made of.
//
// https://www.iso.org/standard/83102.html
//
// Bytes in, data out. A file is read into a tree of boxes and written back from
// it; a box this package has no name for keeps its payload and its header form,
// so a file written back is byte for byte the file that was read.
import {
  "moonbitlang/core/buffer",
  "moonbitlang/core/debug",
  "moonbitlang/core/encoding/utf8",
}

import {
  "moonbitlang/core/encoding/base64",
} for "test"
