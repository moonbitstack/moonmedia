name = "moonbitstack/moonmedia"

version = "0.2.0"

readme = "README.md"

repository = "https://github.com/moonbitstack/moonmedia"

license = "Apache-2.0"

keywords = [
  "streaming",
  "video",
  "media",
  "hls",
  "m3u8",
  "dash",
  "mpeg-dash",
  "mpd",
  "mpeg-ts",
  "ts",
  "mp4",
  "fmp4",
  "cmaf",
  "iso-bmff",
  "segment-template",
  "byte-range",
  "rtmp",
  "playlist",
  "container",
  "content-protection",
  "drm",
  "cenc",
  "pssh",
  "live-streaming",
  "moonbit",
]

description = "Streaming playlists and containers for MoonBit: m3u8, MPD, MPEG-TS, fMP4 and RTMP."

source = "src"

import {
  "moonbitstack/moonbase@0.5.0",
}
